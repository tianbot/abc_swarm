<?xml version="1.0" ?>
<launch>
  <!-- 反馈与跟随参数各自加载；命令行非空值才覆盖配置。 -->
  <arg name="feedback_config" default="$(find abc_swarm)/config/feedback.yaml"/>
  <arg name="follow_config" default="$(find abc_swarm)/config/leader_follower.yaml"/>
  <!-- 三车跟随配置：triangle 为01带02/03，snake 为01带02再由02带03。 -->
  <arg name="formation"/>
  <arg name="spacing" default="0.5"/>
  <arg name="front_distance" default=""/>
  <arg name="k_x" default=""/>
  <arg name="k_y" default=""/>
  <arg name="max_linear" default=""/>
  <arg name="max_angular" default=""/>
  <arg name="tf_timeout" default=""/>
  <arg name="odom_timeout" default=""/>
  <arg name="odom_future_tolerance" default=""/>
  <!-- 设备映射：名称决定话题，frame 决定 TF；以下每个 include 配置一条跟随边。 -->
  <arg name="robot_name_1" default="tianbot_mini_01"/>
  <arg name="rigid_body_1" default="$(arg robot_name_1)"/>
  <arg name="robot_name_2" default="tianbot_mini_02"/>
  <arg name="rigid_body_2" default="$(arg robot_name_2)"/>
  <arg name="robot_name_3" default="tianbot_mini_03"/>
  <arg name="rigid_body_3" default="$(arg robot_name_3)"/>
  <!-- 三角形跟随边：02跟01，目标在01左后方。 -->
  <include file="$(find abc_swarm)/launch/common/leader_follower_tracker.launch.xml" if="$(eval arg('formation') == 'triangle')">
    <arg name="follow_config" value="$(arg follow_config)"/>
    <arg name="feedback_config" value="$(arg feedback_config)"/>
    <arg name="leader_name" value="$(arg robot_name_1)"/>
    <arg name="follower_name" value="$(arg robot_name_2)"/>
    <arg name="leader_frame" value="$(arg rigid_body_1)"/>
    <arg name="follower_frame" value="$(arg rigid_body_2)"/>
    <arg name="offset_x" value="$(eval -float(arg('spacing')))"/>
    <arg name="offset_y" value="$(arg spacing)"/>
    <arg name="front_distance" value="$(arg front_distance)"/>
    <arg name="k_x" value="$(arg k_x)"/>
    <arg name="k_y" value="$(arg k_y)"/>
    <arg name="max_linear" value="$(arg max_linear)"/>
    <arg name="max_angular" value="$(arg max_angular)"/>
    <arg name="tf_timeout" value="$(arg tf_timeout)"/>
    <arg name="odom_timeout" value="$(arg odom_timeout)"/>
    <arg name="odom_future_tolerance" value="$(arg odom_future_tolerance)"/>
  </include>
  <!-- 三角形跟随边：03跟01，目标在01右后方。 -->
  <include file="$(find abc_swarm)/launch/common/leader_follower_tracker.launch.xml" if="$(eval arg('formation') == 'triangle')">
    <arg name="follow_config" value="$(arg follow_config)"/>
    <arg name="feedback_config" value="$(arg feedback_config)"/>
    <arg name="leader_name" value="$(arg robot_name_1)"/>
    <arg name="follower_name" value="$(arg robot_name_3)"/>
    <arg name="leader_frame" value="$(arg rigid_body_1)"/>
    <arg name="follower_frame" value="$(arg rigid_body_3)"/>
    <arg name="offset_x" value="$(eval -float(arg('spacing')))"/>
    <arg name="offset_y" value="$(eval -float(arg('spacing')))"/>
    <arg name="front_distance" value="$(arg front_distance)"/>
    <arg name="k_x" value="$(arg k_x)"/>
    <arg name="k_y" value="$(arg k_y)"/>
    <arg name="max_linear" value="$(arg max_linear)"/>
    <arg name="max_angular" value="$(arg max_angular)"/>
    <arg name="tf_timeout" value="$(arg tf_timeout)"/>
    <arg name="odom_timeout" value="$(arg odom_timeout)"/>
    <arg name="odom_future_tolerance" value="$(arg odom_future_tolerance)"/>
  </include>
  <!-- 蛇形跟随边：02跟01，纵向间隔为 spacing。 -->
  <include file="$(find abc_swarm)/launch/common/leader_follower_tracker.launch.xml" if="$(eval arg('formation') == 'snake')">
    <arg name="follow_config" value="$(arg follow_config)"/>
    <arg name="feedback_config" value="$(arg feedback_config)"/>
    <arg name="leader_name" value="$(arg robot_name_1)"/>
    <arg name="follower_name" value="$(arg robot_name_2)"/>
    <arg name="leader_frame" value="$(arg rigid_body_1)"/>
    <arg name="follower_frame" value="$(arg rigid_body_2)"/>
    <arg name="offset_x" value="$(eval -float(arg('spacing')))"/>
    <arg name="offset_y" value="0.0"/>
    <arg name="front_distance" value="$(arg front_distance)"/>
    <arg name="k_x" value="$(arg k_x)"/>
    <arg name="k_y" value="$(arg k_y)"/>
    <arg name="max_linear" value="$(arg max_linear)"/>
    <arg name="max_angular" value="$(arg max_angular)"/>
    <arg name="tf_timeout" value="$(arg tf_timeout)"/>
    <arg name="odom_timeout" value="$(arg odom_timeout)"/>
    <arg name="odom_future_tolerance" value="$(arg odom_future_tolerance)"/>
  </include>
  <!-- 蛇形跟随边：03跟02，速度前馈来自02实测 odom。 -->
  <include file="$(find abc_swarm)/launch/common/leader_follower_tracker.launch.xml" if="$(eval arg('formation') == 'snake')">
    <arg name="follow_config" value="$(arg follow_config)"/>
    <arg name="feedback_config" value="$(arg feedback_config)"/>
    <arg name="leader_name" value="$(arg robot_name_2)"/>
    <arg name="follower_name" value="$(arg robot_name_3)"/>
    <arg name="leader_frame" value="$(arg rigid_body_2)"/>
    <arg name="follower_frame" value="$(arg rigid_body_3)"/>
    <arg name="offset_x" value="$(eval -float(arg('spacing')))"/>
    <arg name="offset_y" value="0.0"/>
    <arg name="front_distance" value="$(arg front_distance)"/>
    <arg name="k_x" value="$(arg k_x)"/>
    <arg name="k_y" value="$(arg k_y)"/>
    <arg name="max_linear" value="$(arg max_linear)"/>
    <arg name="max_angular" value="$(arg max_angular)"/>
    <arg name="tf_timeout" value="$(arg tf_timeout)"/>
    <arg name="odom_timeout" value="$(arg odom_timeout)"/>
    <arg name="odom_future_tolerance" value="$(arg odom_future_tolerance)"/>
  </include>
</launch>
