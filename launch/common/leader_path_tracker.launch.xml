<?xml version="1.0"?>
<launch>
  <!-- Head path controller only: caller owns followers, backend and runtime. -->
  <arg name="formation"/>
  <arg name="shape" default="circle"/>
  <arg name="radius" default="0.8"/>
  <arg name="width" default="2.5"/>
  <arg name="height" default="2.0"/>
  <arg name="speed" default="0.15"/>
  <arg name="laps" default="1"/>
  <arg name="clockwise" default="false"/>
  <arg name="spacing" default="0.5"/>
  <arg name="front_distance" default="0.1"/>
  <arg name="backward_spacing" default="$(eval -float(arg('spacing')))"/>
  <arg name="max_angular" default=""/>
  <arg name="tf_timeout" default=""/>
  <arg name="robot_name_1" default="tianbot_mini_01"/>
  <arg name="rigid_body_1" default="$(arg robot_name_1)"/>
  <arg name="robot_name_2" default="tianbot_mini_02"/>
  <arg name="rigid_body_2" default="$(arg robot_name_2)"/>
  <arg name="robot_name_3" default="tianbot_mini_03"/>
  <arg name="rigid_body_3" default="$(arg robot_name_3)"/>
  <node pkg="abc_swarm" type="preset_path_tracker.py" name="abc_swarm_path" output="screen" required="true">
    <rosparam command="load" file="$(find abc_swarm)/config/path_tracking.yaml"/>
    <param if="$(eval arg('max_angular') != '')" name="max_angular" value="$(arg max_angular)" type="double"/>
    <param if="$(eval arg('tf_timeout') != '')" name="tf_timeout" value="$(arg tf_timeout)" type="double"/>
    <param name="front_distance" value="$(arg front_distance)"/>
    <param name="shape" value="$(arg shape)"/>
    <param name="radius" value="$(arg radius)"/>
    <param name="width" value="$(arg width)"/>
    <param name="height" value="$(arg height)"/>
    <param name="speed" value="$(arg speed)"/>
    <param name="laps" value="$(arg laps)"/>
    <param name="clockwise" value="$(arg clockwise)"/>
    <rosparam param="edges">[]</rosparam>
    <rosparam param="follower_status_topics">[]</rosparam>
    <param name="robot_frame" value="$(arg rigid_body_1)"/>
    <param name="cmd_topic" value="/$(arg robot_name_1)/cmd_vel"/>
  </node>
  <group if="$(eval arg('formation') == 'triangle')">
    <rosparam param="/abc_swarm_path/follower_status_topics" subst_value="true">[&quot;/$(arg robot_name_2)_leader_follower/status&quot;, &quot;/$(arg robot_name_3)_leader_follower/status&quot;]</rosparam>
    <rosparam param="/abc_swarm_path/edges" subst_value="true">- {leader: &quot;$(arg rigid_body_1)&quot;, follower: &quot;$(arg rigid_body_2)&quot;, x: $(arg backward_spacing), y: $(arg spacing)}
- {leader: &quot;$(arg rigid_body_1)&quot;, follower: &quot;$(arg rigid_body_3)&quot;, x: $(arg backward_spacing), y: $(arg backward_spacing)}
</rosparam>
  </group>
  <group if="$(eval arg('formation') == 'snake')">
    <rosparam param="/abc_swarm_path/follower_status_topics" subst_value="true">[&quot;/$(arg robot_name_2)_leader_follower/status&quot;, &quot;/$(arg robot_name_3)_leader_follower/status&quot;]</rosparam>
    <rosparam param="/abc_swarm_path/edges" subst_value="true">- {leader: &quot;$(arg rigid_body_1)&quot;, follower: &quot;$(arg rigid_body_2)&quot;, x: $(arg backward_spacing), y: 0.0}
- {leader: &quot;$(arg rigid_body_2)&quot;, follower: &quot;$(arg rigid_body_3)&quot;, x: $(arg backward_spacing), y: 0.0}
</rosparam>
  </group>
</launch>
