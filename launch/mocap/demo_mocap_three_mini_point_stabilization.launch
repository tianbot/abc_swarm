<?xml version="1.0"?>
<launch>
  <!-- 后台与显示：可复用已运行的 Mini 驱动和 VRPN。 -->
  <arg name="site_config" default="$(find abc_swarm)/config/mocap.yaml"/>
  <arg name="vrpn_server_ip" default="$(optenv ABC_SWARM_VRPN_SERVER)"/>
  <arg name="vrpn_port" default=""/>
  <arg name="start_driver" default="true"/>
  <arg name="start_vrpn" default="true"/>
  <arg name="use_rviz" default="false"/>
  <!-- 任务配置：goal_config 同时包含目标、控制增益和可选标定；formation 非 config 时重新生成队形目标。 -->
  <arg name="feedback_config" default="$(find abc_swarm)/config/feedback.yaml"/>
  <arg name="control_config" default="$(find abc_swarm)/config/point_control.yaml"/>
  <arg name="goal_config" default="$(find abc_swarm)/config/point_stabilization.yaml"/>
  <arg name="avoidance" default="none"/>
  <arg name="planning" default="true"/>
  <arg name="velocity_source" default="mocap"/>
  <arg name="admission_config" default="$(find abc_swarm)/config/admission.yaml"/>
  <arg name="orca_config" default="$(find abc_swarm)/config/orca.yaml"/>
  <arg name="formation" default="config"/>
  <arg name="spacing" default="0.5"/>
  <arg name="max_linear" default=""/>
  <!-- 逐车映射：robots 顺序与目标列表顺序对应，话题名和刚体名分别配置。 -->
  <arg name="robot_name_1" default="tianbot_mini_01"/>
  <arg name="robot_name_2" default="tianbot_mini_02"/>
  <arg name="robot_name_3" default="tianbot_mini_03"/>
  <arg name="rigid_body_1" default="$(arg robot_name_1)"/>
  <arg name="rigid_body_2" default="$(arg robot_name_2)"/>
  <arg name="rigid_body_3" default="$(arg robot_name_3)"/>
  <!-- 后台模块：按开关启动底盘驱动和 VRPN。 -->
  <include file="$(find abc_swarm)/launch/common/mocap_backend.launch.xml">
    <arg name="site_config" value="$(arg site_config)"/>
    <arg name="vrpn_server_ip" value="$(arg vrpn_server_ip)"/>
    <arg name="vrpn_port" value="$(arg vrpn_port)"/>
    <arg name="start_driver" value="$(arg start_driver)"/>
    <arg name="start_vrpn" value="$(arg start_vrpn)"/>
  </include>
  <!-- 点镇定模块：读取反馈后自动向冻结目标运动；none 直接控制，orca 先规划避让再精定位。 -->
  <node pkg="abc_swarm" type="point_stabilization.py" name="abc_swarm_demo" output="screen" required="true" clear_params="true">
    <!-- 参数顺序：先加载 goal_config，后面的 formation、spacing 和非空 max_linear 再覆盖。 -->
    <rosparam command="load" file="$(arg feedback_config)"/>
    <rosparam command="load" file="$(arg control_config)"/>
    <rosparam command="load" file="$(arg goal_config)"/>
    <!-- 仅记录参数来源供 effective_config 显示；不会改写控制指令。 -->
    <param name="config_sources/goals" value="$(arg goal_config)"/>
    <param name="config_sources/feedback" value="$(arg feedback_config)"/>
    <param name="config_sources/control" value="$(arg control_config)"/>
    <param name="config_sources/admission" value="$(arg admission_config)"/>
    <param if="$(eval arg('avoidance') == 'orca')" name="config_sources/orca" value="$(arg orca_config)"/>

    <param name="avoidance" value="$(arg avoidance)"/>
    <rosparam command="load" file="$(arg admission_config)" param="admission"/>
    <param name="planning" value="$(arg planning)" type="bool"/>
    <param name="velocity_source" value="$(arg velocity_source)"/>
    <rosparam if="$(eval arg('avoidance') == 'orca')" command="load" file="$(arg orca_config)" param="orca"/>
    <param name="formation" value="$(arg formation)"/>
    <param name="spacing" value="$(arg spacing)"/>
    <param if="$(eval arg('max_linear') != '')" name="max_linear" value="$(arg max_linear)" type="double"/>
    <rosparam param="robots" subst_value="true">
      - {name: "$(arg robot_name_1)", frame: "$(arg rigid_body_1)"}
      - {name: "$(arg robot_name_2)", frame: "$(arg rigid_body_2)"}
      - {name: "$(arg robot_name_3)", frame: "$(arg rigid_body_3)"}
    </rosparam>
  </node>
  <!-- 显示模块：可选显示 TF 与目标。 -->
  <node if="$(arg use_rviz)" pkg="rviz" type="rviz" name="demo_rviz" args="-d $(find abc_swarm)/rviz/path_following.rviz"/>
</launch>
