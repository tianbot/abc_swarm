<launch>
    <arg name="robot_name" default="$(optenv ROBOT_NAME /)" doc="robot name [robot_No1, robot_No2, robot_No3, ...]"/>
    <arg name="plan_topic" default="path" doc="topic name of the path to track" />
    <arg name="fixed_frame" default="world" doc="fixed frame" />
    <arg name="use_rviz" default="false" />
    <include file="$(find abc_swarm)/launch/path_generator_with_clickpoints.launch">
        <arg name="robot_name" value="$(arg robot_name)" />
        <arg name="fixed_frame" value="$(arg fixed_frame)" />
        <arg name="use_rviz" value="$(arg use_rviz)" />
    </include>
    <group ns="$(arg robot_name)">
        <node pkg="abc_swarm" type="pure_pursuit.py" name="path_tracker" output="screen">
            <param name="robot_name" value="$(arg robot_name)" />
            <param name="plan_topic" value="$(arg plan_topic)" />
        </node>
    </group>
</launch>