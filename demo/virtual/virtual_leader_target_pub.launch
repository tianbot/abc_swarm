<launch>
    <arg name="global_frame_id" default="world" doc="fixed frame [world, map, odom, ...]"/>
    <arg name="leader_frame_id" default="leader" doc="center frame id"/>
    <arg name="target_frame_id_prefix" default="rmtt" doc="target frame id prefix"/>
    <arg name="speed" default="0.1" doc="speed"/>
    <arg name="radius" default="0.5" doc="radius"/>

    <node pkg="abc_swarm" type="virtual_leader.py" name="virtual_leader" output="screen">
        <param name="global_frame_id" value="$(arg global_frame_id)" />
        <param name="leader_frame_id" value="$(arg leader_frame_id)" />
        <param name="radius" value="$(arg radius)" />
        <param name="speed" value="$(arg speed)" />
    </node>
    <node pkg="abc_swarm" type="virtual_targets.py" name="virtual_targets" output="screen">
        <param name="global_frame_id" value="$(arg global_frame_id)" />
        <param name="center_frame_id" value="$(arg leader_frame_id)" />
        <param name="target_frame_id_prefix" value="$(arg target_frame_id_prefix)" />
        <param name="radius" value="$(arg radius)" />
        <param name="speed" value="$(arg speed)" />
    </node>

    <!-- RVIZ可视化调试工具 -->
    <node name="rviz" pkg="rviz" type="rviz" args="-d $(find abc_swarm)/rviz/virtual_leader_targets_rmtt.rviz -f world" />
</launch>
