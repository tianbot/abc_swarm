<?xml version="1.0" ?>
<launch>
  <arg name="use_sim_time" default="false"/>
  <arg name="startup" default="true"/>
  <arg name="control_config" default="$(find abc_swarm)/config/point_stabilization.yaml"/>
  <arg name="orca_config" default="$(find abc_swarm)/config/orca.yaml"/>
  <arg name="admission_config" default="$(find abc_swarm)/config/admission.yaml"/>
  <arg name="velocity_source" default="mocap"/>
  <arg name="command_timeout" default="0.3"/>
  <arg name="tracking_window" default="0.15"/>
  <arg name="lookahead" default="0.25"/>
  <arg name="max_error" default="0.5"/>
  <arg name="shape" default="circle"/>
  <arg name="width" default="2.5"/>
  <arg name="height" default="2.0"/>
  <arg name="mode" default="manual"/>
  <arg name="resolved_mode" value="$(eval {'manual': 'manual', 'auto': 'auto'}[arg('mode')])"/>
  <arg name="radius" default="1.0"/>
  <arg name="laps" default="1"/>
  <arg name="clockwise" default="false"/>
  <arg name="use_rviz" default="false"/>
  <arg name="teleop_terminal" default="xterm -e"/>
  <arg name="start_teleop" default="true"/>
  <arg name="vrpn_port" default=""/>
  <arg name="site_config" default="$(find abc_swarm)/config/mocap.yaml"/>
  <arg name="vrpn_server_ip" default="$(optenv ABC_SWARM_VRPN_SERVER)"/>
  <arg name="start_vrpn" default="true"/>
  <arg name="start_driver" default="true"/>
  <arg name="spacing" default="0.5"/>
  <arg name="backward_spacing" value="$(eval -float(arg('spacing')))"/>
  <arg name="front_distance" default="0.1"/>
  <arg name="k_x" default="0.5"/>
  <arg name="k_y" default="0.5"/>
  <arg name="max_linear" default="0.15"/>
  <arg name="max_angular" default="0.6"/>
  <arg name="tf_timeout" default="0.5"/>
  <arg name="odom_timeout" default="0.5"/>
  <arg name="odom_future_tolerance" default="0.1"/>
  <arg name="robot_name_1" default="tianbot_mini_01"/>
  <arg name="rigid_body_1" default="$(arg robot_name_1)"/>
  <arg name="robot_name_2" default="tianbot_mini_02"/>
  <arg name="rigid_body_2" default="$(arg robot_name_2)"/>
  <arg name="robot_name_3" default="tianbot_mini_03"/>
  <arg name="rigid_body_3" default="$(arg robot_name_3)"/>
  <param name="/abc_swarm_demo/enabled" value="false" type="bool"/>
  <include file="$(find abc_swarm)/launch/common/mocap_backend.launch.xml">
    <arg name="site_config" value="$(arg site_config)"/>
    <arg name="vrpn_server_ip" value="$(arg vrpn_server_ip)"/>
    <arg name="vrpn_port" value="$(arg vrpn_port)"/>
    <arg name="start_driver" value="$(arg start_driver)"/>
    <arg name="use_sim_time" value="$(arg use_sim_time)"/>
    <arg name="start_vrpn" value="$(arg start_vrpn)"/>
  </include>
  <include unless="$(arg startup)" file="$(find abc_swarm)/launch/common/three_mini_leader_follower.launch.xml">
    <arg name="formation" value="triangle"/>
    <arg name="spacing" value="$(arg spacing)"/>
    <arg name="front_distance" value="$(arg front_distance)"/>
    <arg name="k_x" value="$(arg k_x)"/>
    <arg name="k_y" value="$(arg k_y)"/>
    <arg name="max_linear" value="$(arg max_linear)"/>
    <arg name="max_angular" value="$(arg max_angular)"/>
    <arg name="tf_timeout" value="$(arg tf_timeout)"/>
    <arg name="odom_timeout" value="$(arg odom_timeout)"/>
    <arg name="odom_future_tolerance" value="$(arg odom_future_tolerance)"/>
    <arg name="robot_name_1" value="$(arg robot_name_1)"/>
    <arg name="rigid_body_1" value="$(arg rigid_body_1)"/>
    <arg name="robot_name_2" value="$(arg robot_name_2)"/>
    <arg name="rigid_body_2" value="$(arg rigid_body_2)"/>
    <arg name="robot_name_3" value="$(arg robot_name_3)"/>
    <arg name="rigid_body_3" value="$(arg rigid_body_3)"/>
  </include>
  <include if="$(eval arg('resolved_mode') == 'auto' and not arg('startup'))" file="$(find abc_swarm)/launch/common/leader_path_tracker.launch.xml">
    <arg name="formation" value="triangle"/>
    <arg name="shape" value="$(arg shape)"/>
    <arg name="width" value="$(arg width)"/>
    <arg name="height" value="$(arg height)"/>
    <arg name="radius" value="$(arg radius)"/>
    <arg name="speed" value="$(arg max_linear)"/>
    <arg name="laps" value="$(arg laps)"/>
    <arg name="clockwise" value="$(arg clockwise)"/>
    <arg name="spacing" value="$(arg spacing)"/>
    <arg name="front_distance" value="$(arg front_distance)"/>
    <arg name="max_angular" value="$(arg max_angular)"/>
    <arg name="tf_timeout" value="$(arg tf_timeout)"/>
    <arg name="robot_name_1" value="$(arg robot_name_1)"/>
    <arg name="rigid_body_1" value="$(arg rigid_body_1)"/>
    <arg name="robot_name_2" value="$(arg robot_name_2)"/>
    <arg name="rigid_body_2" value="$(arg rigid_body_2)"/>
    <arg name="robot_name_3" value="$(arg robot_name_3)"/>
    <arg name="rigid_body_3" value="$(arg rigid_body_3)"/>
  </include>
  <node if="$(arg startup)" pkg="abc_swarm" type="point_stabilization.py" name="abc_swarm_demo" output="screen" required="true" clear_params="true">
    <rosparam command="load" file="$(arg control_config)"/>
    <rosparam command="load" file="$(arg orca_config)" param="orca"/>
    <rosparam command="load" file="$(arg admission_config)" param="admission"/>
    <param name="task" value="leader_follower"/>
    <param name="avoidance" value="orca"/>
    <param name="velocity_source" value="$(arg velocity_source)"/>
    <param name="max_linear" value="$(arg max_linear)" type="double"/>
    <param name="max_angular" value="$(arg max_angular)" type="double"/>
    <param name="tf_timeout" value="$(arg tf_timeout)" type="double"/>
    <param name="command_timeout" value="$(arg command_timeout)" type="double"/>
    <param name="formation" value="triangle"/>
    <rosparam param="robots" subst_value="true">
      - {name: "$(arg robot_name_1)", frame: "$(arg rigid_body_1)"}
      - {name: "$(arg robot_name_2)", frame: "$(arg rigid_body_2)"}
      - {name: "$(arg robot_name_3)", frame: "$(arg rigid_body_3)"}
    </rosparam>
    <rosparam param="follow" subst_value="true">
      mode: "$(arg resolved_mode)"
      shape: "$(arg shape)"
      radius: $(arg radius)
      width: $(arg width)
      height: $(arg height)
      laps: $(arg laps)
      clockwise: $(arg clockwise)
      front_distance: $(arg front_distance)
      k_x: $(arg k_x)
      k_y: $(arg k_y)
      tracking_window: $(arg tracking_window)
      lookahead: $(arg lookahead)
      max_error: $(arg max_error)
      edges:
        - {leader: "$(arg robot_name_1)", follower: "$(arg robot_name_2)", x: $(arg backward_spacing), y: $(arg spacing)}
        - {leader: "$(arg robot_name_1)", follower: "$(arg robot_name_3)", x: $(arg backward_spacing), y: $(arg backward_spacing)}
    </rosparam>
  </node>
  <node unless="$(arg startup)" pkg="abc_swarm" type="demo_runtime.py" name="abc_swarm_demo" output="screen" required="true" clear_params="false">
    <param name="mode" value="$(eval 'path' if arg('resolved_mode') == 'auto' else 'manual')"/>
    <param name="max_linear" value="$(arg max_linear)"/>
    <param name="odom_future_tolerance" value="$(arg odom_future_tolerance)"/>
    <param name="fixed_frame" value="world"/>
    <rosparam param="robot_frames" subst_value="true">[&quot;$(arg rigid_body_1)&quot;, &quot;$(arg rigid_body_2)&quot;, &quot;$(arg rigid_body_3)&quot;]</rosparam>
    <rosparam param="feedback_topics" subst_value="true">[&quot;/$(arg robot_name_1)/odom&quot;]</rosparam>
    <param name="cmd_topic" value="/$(arg robot_name_1)/cmd_vel"/>
  </node>
  <node if="$(eval arg('resolved_mode') == 'manual' and arg('start_teleop'))" pkg="teleop_twist_keyboard" type="teleop_twist_keyboard.py" name="leader_teleop" output="screen" launch-prefix="$(arg teleop_terminal)">
    <remap from="cmd_vel" to="/abc_swarm_demo/teleop_cmd"/>
    <param name="speed" value="$(arg max_linear)"/>
    <param name="turn" value="$(arg max_angular)"/>
    <param name="repeat_rate" value="20.0"/>
    <param name="key_timeout" value="0.3"/>
  </node>
  <node if="$(arg use_rviz)" pkg="rviz" type="rviz" name="demo_rviz" args="$(eval '-d '+find('abc_swarm')+('/rviz/coordinated_tracking.rviz' if arg('startup') else '/rviz/path_following.rviz'))">
    <remap from="/abc_swarm_demo/paths/tianbot_mini_01" to="/abc_swarm_demo/paths/$(arg robot_name_1)"/>
    <remap from="/abc_swarm_demo/paths/tianbot_mini_02" to="/abc_swarm_demo/paths/$(arg robot_name_2)"/>
    <remap from="/abc_swarm_demo/paths/tianbot_mini_03" to="/abc_swarm_demo/paths/$(arg robot_name_3)"/>
  </node>
</launch>
