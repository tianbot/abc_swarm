<launch>
    <arg name="robot_name" default="$(optenv ROBOT_NAME /)" doc="robot name [robot_No1, robot_No2, robot_No3, ...]"/>
    <arg name="fixed_frame" default="world" doc="fixed frame [world, map, odom, ...]"/>
    <arg name="use_rviz" default="false" />

    <!-- launch path generator with clickpoints in rviz viewport -->
    <group ns="$(arg robot_name)">
        <node name="path_generator" pkg="abc_swarm" type="cubic_spline_with_clickpoints.py" output="screen" >
            <param name="robot_name" value="$(arg robot_name)" />
            <param name="global_frame_id" value="$(arg fixed_frame)" />
            <param name="path_topic" value="$(arg robot_name)/path" />
        </node>
    </group>

    <!-- launch rviz -->
    <node  ns="$(arg robot_name)" pkg="rviz" type="rviz" name="rviz" args="-d $(find abc_swarm)/rviz/path_generator.rviz -f $(arg fixed_frame)" if="$(arg use_rviz)" />
</launch>